# 统一行尾：PHP 源码与协议向量必须是 LF，避免签名原文因 CRLF 产生跨平台差异。
* text=auto eol=lf
*.php text eol=lf
*.json text eol=lf
*.md text eol=lf
*.pem text eol=lf

# 二进制/固定内容不做行尾转换。
*.png binary
*.jpg binary

# ------------------------------------------------------------------
# composer install 时排除开发期文件，缩小下游 vendor 体积。
#
# 保留在分发包中：
#   protocol/test-vectors-v1.json  跨语言协议事实来源，其他语言 SDK 需消费
#   protocol/README.md             协议字节级规则说明
# 排除：
#   protocol/conformance/          Python/Go 验证实现，只在本仓库 CI 中运行
#   tools/                         开发期检查脚本，下游不需要
# ------------------------------------------------------------------
/tests                    export-ignore
/docs                     export-ignore
/tools                    export-ignore
/protocol/conformance     export-ignore
/.github                  export-ignore
/.idea                    export-ignore
/.claude                  export-ignore
/phpunit.xml.dist         export-ignore
/.gitattributes           export-ignore
/.gitignore               export-ignore
/.phpunit.result.cache    export-ignore
