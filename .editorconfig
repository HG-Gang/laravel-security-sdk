# EditorConfig：让 IDE 保存时自动产出符合本项目硬约束的格式
# https://editorconfig.org
#
# 为什么需要它：
# 本项目只有三条硬性格式约束（空格缩进、无 BOM、LF 行尾），
# 但违反任一条都会让 composer verify 失败。
# 把约束写在这里，IDE 保存时自动遵守，不依赖人工记忆。
#
# PhpStorm / VS Code / Sublime 均原生支持本文件，且优先级高于 IDE 自身的
# Code Style 设置——因此可以放心继续使用「保存时格式化」。
#
# 本文件不约束的部分（项目不检查，随个人审美）：
# 花括号位置、空行数量、数组与 => 是否对齐、参数换行方式。

root = true

# ------------------------------------------------------------------
# 全局默认
# ------------------------------------------------------------------
[*]
# LF 行尾：签名规范化串以 \n 连接字段，CRLF 会让 Windows 端与 Linux 端
# 算出不同的签名，表现为跨平台验签失败。
end_of_line = lf

# UTF-8 无 BOM：BOM 在 Laravel 中产生提前输出，破坏 header() 调用。
charset = utf-8

# 文件末尾保留换行符，避免 diff 出现「无换行符」标记。
insert_final_newline = true

# 去除行尾多余空格，减少无意义 diff。
trim_trailing_whitespace = true

# ------------------------------------------------------------------
# PHP：项目主体
# ------------------------------------------------------------------
[*.php]
# 必须空格缩进，宽度 4。Tab 会被 composer audit-style 与 ApiStyleTest 拦截。
indent_style = space
indent_size = 4

# ------------------------------------------------------------------
# Markdown：行尾空格有语义
# ------------------------------------------------------------------
[*.md]
# 行尾两个空格是 Markdown 的软换行写法，不能去掉。
trim_trailing_whitespace = false
indent_style = space
indent_size = 2

# ------------------------------------------------------------------
# YAML / JSON：2 空格是生态惯例
# ------------------------------------------------------------------
[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.json]
indent_style = space
indent_size = 4

# ------------------------------------------------------------------
# Go：必须 Tab
# ------------------------------------------------------------------
[*.go]
# gofmt 强制 Tab 缩进，CI 的 protocol 作业会执行 gofmt -l 检查；
# 改成空格会让该作业失败。这是有意的例外，不是遗漏。
indent_style = tab

# ------------------------------------------------------------------
# Python：协议一致性实现
# ------------------------------------------------------------------
[*.py]
indent_style = space
indent_size = 4

# ------------------------------------------------------------------
# Makefile：Tab 是语法要求
# ------------------------------------------------------------------
[Makefile]
indent_style = tab
